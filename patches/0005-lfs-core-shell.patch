index d56c7f5..e4da7ab 100644
--- a/subprocess/subprocess_windows.go
+++ b/subprocess/subprocess_windows.go
@@ -4,7 +4,12 @@
 package subprocess
 
 import (
+	"fmt"
+	"os"
 	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
 	"syscall"
 )
 
@@ -20,3 +25,62 @@ func ExecCommand(name string, arg ...string) (*Cmd, error) {
 	cmd.Env = fetchEnvironment()
 	return newCmd(cmd), nil
 }
+
+var shellCache struct {
+	sync.Mutex
+	dir        string
+	generation uint64
+	path       string
+	err        error
+	ready      bool
+}
+
+// Cache Git's shell for the current repository/environment, not for the entire
+// process: clone can change directories and ResetEnvironment can change config.
+// Serialize the lookup so concurrent transfer workers only invoke Git once.
+func shellPath() (string, error) {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "", fmt.Errorf("resolving Git shell working directory: %w", err)
+	}
+	envMu.Lock()
+	environment := fetchEnvironmentInternal()
+	generation := envGeneration
+	envMu.Unlock()
+
+	shellCache.Lock()
+	defer shellCache.Unlock()
+	if shellCache.ready && shellCache.dir == dir && shellCache.generation == generation {
+		return shellCache.path, shellCache.err
+	}
+	shellCache.dir = dir
+	shellCache.generation = generation
+	shellCache.path, shellCache.err = resolveShellPath(dir, environment)
+	shellCache.ready = true
+	return shellCache.path, shellCache.err
+}
+
+func resolveShellPath(dir string, environment []string) (string, error) {
+	cmd, err := ExecCommand("git", "var", "GIT_SHELL_PATH")
+	if err != nil {
+		return "", fmt.Errorf("resolving Git shell: %w", err)
+	}
+	cmd.Dir = dir
+	cmd.Env = environment
+	out, err := cmd.Output()
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			return "", fmt.Errorf("git var GIT_SHELL_PATH: %w: %s", err, strings.TrimSpace(string(exitErr.Stderr)))
+		}
+		return "", fmt.Errorf("git var GIT_SHELL_PATH: %w", err)
+	}
+	shell := filepath.FromSlash(strings.TrimSuffix(strings.TrimSuffix(string(out), "\n"), "\r"))
+	if shell == "" {
+		return "", fmt.Errorf("git var GIT_SHELL_PATH returned an empty shell")
+	}
+	resolved, err := LookPath(shell)
+	if err != nil {
+		return "", fmt.Errorf("resolving Git shell %q: %w", shell, err)
+	}
+	return resolved, nil
+}
