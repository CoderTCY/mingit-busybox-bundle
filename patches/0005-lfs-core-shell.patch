diff --git a/ssh/ssh.go b/ssh/ssh.go
index 401e7a0..d2838ef 100644
--- a/ssh/ssh.go
+++ b/ssh/ssh.go
@@ -29,19 +29,19 @@ type SSHMetadata struct {
 	Path        string
 }
 
-func FormatArgs(cmd string, args []string, needShell bool) (string, []string) {
+func FormatArgs(cmd string, args []string, needShell bool) (string, []string, error) {
 	if !needShell {
-		return cmd, args
+		return cmd, args, nil
 	}
 
 	return subprocess.FormatForShellQuotedArgs(cmd, args)
 }
 
-func GetLFSExeAndArgs(osEnv config.Environment, gitEnv config.Environment, meta *SSHMetadata, command, operation string, multiplexDesired bool, multiplexControlPath string) (exe string, args []string, multiplexing bool, controlPath string) {
+func GetLFSExeAndArgs(osEnv config.Environment, gitEnv config.Environment, meta *SSHMetadata, command, operation string, multiplexDesired bool, multiplexControlPath string) (exe string, args []string, multiplexing bool, controlPath string, err error) {
 	exe, args, needShell, multiplexing, controlPath := GetExeAndArgs(osEnv, gitEnv, meta, multiplexDesired, multiplexControlPath)
 	args = append(args, strings.Join(subprocess.ShellQuote([]string{command, meta.Path, operation}), " "))
-	exe, args = FormatArgs(exe, args, needShell)
-	return exe, args, multiplexing, controlPath
+	exe, args, err = FormatArgs(exe, args, needShell)
+	return exe, args, multiplexing, controlPath, err
 }
 
 // Parse command, and if it looks like a valid command, return the ssh binary
