 	"github.com/stretchr/testify/require"
 )
@@ -274,7 +275,11 @@ func TestSSHResolveFailsForOtherErrors(t *testing.T) {
 // that tests can obtain a real *exec.ExitError.
 func exitErrorWithCode(t *testing.T, code int) error {
 	t.Helper()
-	err := exec.Command("sh", "-c", fmt.Sprintf("exit %d", code)).Run()
+	name, args, err := subprocess.FormatForShell("exit", fmt.Sprintf("%d", code))
+	require.NoError(t, err)
+	cmd, err := subprocess.ExecCommand(name, args...)
+	require.NoError(t, err)
+	err = cmd.Run()
 	var exitErr *exec.ExitError
 	require.True(t, goerrors.As(err, &exitErr))
 	require.Equal(t, code, exitErr.ExitCode())
